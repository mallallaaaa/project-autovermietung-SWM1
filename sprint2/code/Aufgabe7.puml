
@startuml AV_Aufgabe7

title Schichtenarchitektur AV-System (Sprint 2, Aufgabe 7)

top to bottom direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 75
skinparam classBackgroundColor #F2F2F2

' ================================================
' 1. PRÄSENTATIONSSCHICHT
' ================================================

package "1. Präsentationsschicht" <<Layer>> #F5F5F5 {

  package "Angebotssuche" <<Subsystem>> {
    class SuchUI <<boundary>>
  }

  package "Buchungsdialog" <<Subsystem>> {
    class BuchungsUI <<boundary>>
  }
}

' ================================================
' 2. STEUERUNGS- UND VERARBEITUNGSSCHICHT
' ================================================

package "2. Steuerungs- / Verarbeitungsschicht" <<Layer>> #EAEAEA {

  package "Suchverarbeitung" <<Subsystem>> {
    class SuchSteuerung <<control>>
  }

  package "Buchungsverarbeitung" <<Subsystem>> {
    class Steuerung <<control>>
  }
}

' ================================================
' 3. DATEN-, ENTITÄTS- UND MODELLSCHICHT
' ================================================

package "3. Daten- / Entitäts- / Modellschicht" <<Layer>> #F5F5F5 {

  package "Persistenz" <<Subsystem>> {
    class Datenbank <<control>>
  }

  package "Kunden und Buchungen" <<Subsystem>> {
    class EAngebot <<entity>>
    class EKunde <<entity>>
    class EBuchung <<entity>>
    class EZahlungsinformation <<entity>>
  }

  package "Fahrzeugkatalog und Standorte" <<Subsystem>> {
    class EFahrzeugtyp <<entity>>
    class EFahrzeugmodell <<entity>>
    class EStandort <<entity>>
  }

  package "Buchungszusätze" <<Subsystem>> {
    class EVersicherung <<entity>>
    class EExtra <<entity>>
    class EBuchungExtra <<entity>>
    class EAktionscode <<entity>>
  }

  package "Temporäre Datenobjekte" <<Subsystem>> {
    class Buchungsoptionen <<data>>
    class Zahlungsdaten <<data>>
  }
}

' ================================================
' EXTERNE SYSTEME
' ================================================

package "Externe Systeme" #FFFFFF {
  class Zahlung <<extern>>
  class Mailserver <<extern>>
}

' ================================================
' KONTROLLFLUSS
' ================================================

SuchUI --> SuchSteuerung : sucheAngebote(kriterien)

SuchSteuerung --> Datenbank : sucheAngebote(kriterien)

BuchungsUI --> Steuerung : initBuchung(angebotId)\nsetOptionen(optionen)\nbuche(kunde, zahlungsdaten)

Steuerung --> Datenbank : ladeAngebot(angebotId)\nspeichere(buchung)

Steuerung --> Zahlung : prüfeKarte(zahlungsdaten)

Steuerung --> Mailserver : sendeMail(email, buchungsnummer)

' ================================================
' DATENFLUSS
' ================================================

SuchUI ..> EAngebot : zeigt Suchergebnisse

BuchungsUI ..> EAngebot : zeigt Zusammenfassung
BuchungsUI ..> EKunde : erfasst Kundendaten
BuchungsUI ..> Buchungsoptionen : erfasst Optionen
BuchungsUI ..> Zahlungsdaten : erfasst Zahlungsdaten

SuchSteuerung ..> EFahrzeugtyp : ermittelt Typen
SuchSteuerung ..> EStandort : berücksichtigt Orte

Steuerung ..> EBuchung : erzeugt

Datenbank ..> EAngebot : lädt
Datenbank ..> EBuchung : speichert

Zahlung ..> Zahlungsdaten : prüft temporär

note bottom of Zahlungsdaten
  Nur während der Buchung verwendet.
  Vollständige Kartennummern werden
  nicht dauerhaft gespeichert.
end note

note right of Datenbank
  "Datenbank" ist die Datenzugriffsklasse
  aus Aufgabe 5 und 6.
  Gemeinsam mit den Entitäten ist sie
  hier als architektonische Vereinfachung
  in einer Schicht dargestellt.
  Eine spätere Trennung in Domänen-
  und Datenzugriffsschicht ist möglich.
end note

note right of Zahlung
  Zahlung und Mailserver sind bewusst
  außerhalb der Schichten modelliert,
  da sie externe Dienste und keine
  internen Fach- oder Persistenzklassen sind.
end note

@enduml
