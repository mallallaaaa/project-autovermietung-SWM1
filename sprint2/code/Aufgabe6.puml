
@startuml AV_Aufgabe6

title Klassendiagramm: Fahrzeug buchen (zu Aufgabe 5)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65

skinparam class {
  BackgroundColor<<boundary>> #F2F2F2
  BackgroundColor<<control>> #F2F2F2
  BackgroundColor<<entity>> #F2F2F2
  BackgroundColor<<extern>> #F2F2F2
  BackgroundColor<<data>> #F2F2F2
}

' ==========================================
' KLASSEN AUS DEM SEQUENZDIAGRAMM (AUFGABE 5)
' ==========================================

class BuchungsUI <<boundary>> {
  +wähleBuchen(angebotId: Integer): void
  +zeigeZusammenfassung(angebot: EAngebot): void
  +wähleOptionen(optionen: Buchungsoptionen): void
  +zeigeGesamtpreis(preis: Decimal): void
  +gibDatenEin(kunde: EKunde, zahlungsdaten: Zahlungsdaten): void
  +zeigeBestätigung(buchungsnummer: String): void
}

class Steuerung <<control>> {
  -aktuellesAngebot: EAngebot
  -gewählteOptionen: Buchungsoptionen

  +initBuchung(angebotId: Integer): EAngebot
  +setOptionen(optionen: Buchungsoptionen): Decimal
  +buche(kunde: EKunde, zahlungsdaten: Zahlungsdaten): String

  -erstelleBuchung(angebot: EAngebot, kunde: EKunde, optionen: Buchungsoptionen): EBuchung
}

class Datenbank <<control>> {
  +ladeAngebot(angebotId: Integer): EAngebot
  +speichere(buchung: EBuchung): String
}

class Zahlung <<extern>> {
  +prüfeKarte(zahlungsdaten: Zahlungsdaten): boolean
}

class Mailserver <<extern>> {
  +sendeMail(email: String, buchungsnummer: String): void
}

' ==========================================
' ENTITÄTEN AUS SPRINT 1
' ==========================================

class EAngebot <<entity>> {
  -angebotId: Integer
  -abholDatum: Date
  -rückgabeDatum: Date
  -fahrerAlter: Integer
  -angebotspreis: Decimal
}

class EKunde <<entity>> {
  -kundenId: Integer
  -name: String
  -straße: String
  -plz: String
  -ort: String
  -telefonnummer: String
  -email: String
}

class EBuchung <<entity>> {
  -buchungsId: Integer
  -bestätigungsnummer: String
  -abholDatum: Date
  -rückgabeDatum: Date
  -gesamtpreis: Decimal
  -status: String
}

class EZahlungsinformation <<entity>> {
  -zahlungsId: Integer
  -karteninhaber: String
  -letzteVierZiffern: String
  -gültigBis: Date
  -zahlungsToken: String
  -prüfstatus: String
}

' ==========================================
' TEMPORÄRE DATENOBJEKTE
' ==========================================

class Buchungsoptionen <<data>> {
  -versicherungsIds: List<Integer>
  -extraMengen: Map<Integer, Integer>
  -aktionscode: String
}

class Zahlungsdaten <<data>> {
  -karteninhaber: String
  -kartennummer: String
  -gültigBis: Date
}

' ==========================================
' BEZIEHUNGEN DER SYSTEMKLASSEN
' ==========================================

BuchungsUI --> Steuerung : ruft auf

Steuerung --> Datenbank : lädt / speichert
Steuerung --> Zahlung : prüft Karte
Steuerung --> Mailserver : sendet Bestätigung

' ==========================================
' BEZIEHUNGEN ZWISCHEN DEN ENTITÄTEN
' ==========================================

EKunde "1" -- "0..*" EBuchung : tätigt

EAngebot "1" -- "0..1" EBuchung : führt zu

EBuchung "1" -- "1" EZahlungsinformation : nutzt

' ==========================================
' ABHÄNGIGKEITEN ZU DATENOBJEKTEN
' ==========================================

Steuerung ..> EAngebot : verarbeitet
Steuerung ..> EBuchung : erstellt

BuchungsUI ..> Buchungsoptionen : erfasst
BuchungsUI ..> Zahlungsdaten : erfasst

Steuerung ..> Buchungsoptionen : verarbeitet
Zahlung ..> Zahlungsdaten : prüft

Datenbank ..> EAngebot : lädt
Datenbank ..> EBuchung : speichert

note bottom of Zahlungsdaten
  Nur temporär während der Buchung.
  Vollständige Kreditkartendaten
  werden nicht dauerhaft gespeichert.
end note

@enduml
