@startuml AV_Aufgabe1
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 55

actor "Kunde" as K

rectangle "AV-System" {

  usecase "Fahrzeug\nsuchen" as Search

  usecase "Mietangebot\nanfordern" as Quote

  usecase "Fahrzeugdetails\nansehen" as Details

  usecase "Angebot per\nE-Mail erhalten" as QuoteEmail

  usecase "Fahrzeug\nbuchen" as Book

  usecase "Mietoptionen\nwählen" as Options

  usecase "Mietbedingungen\neinsehen" as Conditions
}

' Hauptfunktionen des Kunden
K -- Search
K -- Quote
K -- Book

' Optionale Funktionen bei der Suche
Quote ..> Search : <<extend>>
Details ..> Search : <<extend>>

' Optionaler E-Mail-Versand
QuoteEmail ..> Quote : <<extend>>

' Buchung
Options ..> Book : <<extend>>
Book ..> Conditions : <<include>>

' Layout
Details -[hidden]- QuoteEmail
Options -[hidden]- Conditions

@enduml
