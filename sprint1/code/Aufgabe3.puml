@startuml AV_Aufgabe3
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 80

class Kunde {
  name
  email
}

class Angebot {
  abholDatum
  rückgabeDatum
  fahrerAlter
  preis
}

class Buchung {
  bestätigungsnummer
}

class Fahrzeugtyp {
  bezeichnung
  sitzplätze
  gepäckkapazität
}

class Standort {
  name
  adresse
}

' Kunde und Angebot
Kunde "0..1" -- "0..*" Angebot : fordert an

' Kunde und Buchung
Kunde "1" -- "0..*" Buchung : tätigt

' Angebot und Buchung
Angebot "1" -- "0..1" Buchung : führt zu

' Fahrzeugtyp
Angebot "0..*" -- "1" Fahrzeugtyp : betrifft

' Abhol- und Rueckgabeort
Angebot "0..*" -- "1" Standort : Abholort
Angebot "0..*" -- "1" Standort : Rückgabeort

@enduml
