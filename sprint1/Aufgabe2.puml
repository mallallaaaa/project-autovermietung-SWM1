
@startuml AV_Aufgabe2
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 25
skinparam ranksep 55

actor "Kunde" as K

rectangle "Autovermietung (AV)" {

  ' Fahrzeugsuche
  usecase "Mietangebote\nermitteln" as Search
  usecase "Suchkriterien\nerfassen" as Criteria
  usecase "Verfügbarkeit\nprüfen" as Availability
  usecase "Mietpreise\nberechnen" as Price
  usecase "Suchergebnisse\nanzeigen" as Results

  ' Optionale Funktionen der Suche
  usecase "Fahrzeugdetails\nanzeigen" as Details
  usecase "Angebot per\nE-Mail versenden" as QuoteEmail

  ' Buchung
  usecase "Buchung\nverarbeiten" as Book
  usecase "Mietdaten zur\nPrüfung anzeigen" as Review
  usecase "Zusatzoptionen\nauswählen" as Options
  usecase "Mietbedingungen\nanzeigen" as Conditions
  usecase "Kunden- und\nZahlungsdaten erfassen" as Data
  usecase "Buchungsdaten und\nKreditkarte validieren" as Validate
  usecase "Buchung speichern und\nBestätigungsnummer erzeugen" as Save
  usecase "Buchungsbestätigung\nper E-Mail versenden" as Confirm
}

' Hauptinteraktionen des Kunden
K -- Search
K -- Details
K -- QuoteEmail
K -- Book

' Obligatorische Funktionen der Suche
Search ..> Criteria : <<include>>
Search ..> Availability : <<include>>
Search ..> Price : <<include>>
Search ..> Results : <<include>>

' Optionale Funktionen nach der Suche
Details ..> Search : <<extend>>
QuoteEmail ..> Search : <<extend>>

' Obligatorische Funktionen der Buchung
Book ..> Review : <<include>>
Book ..> Conditions : <<include>>
Book ..> Data : <<include>>
Book ..> Validate : <<include>>
Book ..> Price : <<include>>
Book ..> Save : <<include>>
Book ..> Confirm : <<include>>

' Optionale Zusatzleistungen
Options ..> Book : <<extend>>

' Happy Scenario
note right of Book
  Voraussetzung: Der Kunde hat
  einen Fahrzeugtyp aus den
  Suchergebnissen ausgewählt.

  Happy Scenario:
  Alle eingegebenen Daten
  und die Kreditkarte sind gültig.
end note

@enduml
