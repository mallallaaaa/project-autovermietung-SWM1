@startuml AV_Aufgabe4

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65

' Kunden
class EKunde {
  kundenId : Integer
  name : String
  straße : String
  plz : String
  ort : String
  telefonnummer : String
  email : String
}

' Mietangebote
class EAngebot {
  angebotId : Integer
  abholDatum : Date
  rückgabeDatum : Date
  fahrerAlter : Integer
  angebotspreis : Decimal
  emailFürAngebot : String
}

' Buchungen
class EBuchung {
  buchungsId : Integer
  bestätigungsnummer : String
  status : String
  gesamtpreis : Decimal
}

' Fahrzeugtypen
class EFahrzeugtyp {
  typId : Integer
  bezeichnung : String
  sitzplätze : Integer
  gepäckkapazität : Integer
  preisProTag : Decimal
  mindestAlter : Integer
  kraftstoffregelung : String
  allgemeineBeschränkungen : String
}

' Fahrzeugmodelle
class EFahrzeugmodell {
  modellId : Integer
  marke : String
  modellName : String
}

' Standorte
class EStandort {
  standortId : Integer
  name : String
  adresse : String
  abholhinweise : String
}

' Versicherungen
class EVersicherung {
  versicherungId : Integer
  bezeichnung : String
  beschreibung : String
  preisProTag : Decimal
}

' Zusatzleistungen
class EExtra {
  extraId : Integer
  bezeichnung : String
  preisProTag : Decimal
}

' Aktionscodes
class EAktionscode {
  code : String
  rabattProzent : Decimal
  gültigBis : Date
}

' Zahlungsinformationen
class EZahlungsinformation {
  zahlungsId : Integer
  karteninhaber : String
  letzteVierZiffern : String
  gültigBis : Date
  zahlungsToken : String
  prüfstatus : String
}

' Gebuchte Extras
class EBuchungExtra {
  buchungExtraId : Integer
  menge : Integer
}

' Beziehungen aus Aufgabe 3

EKunde "0..1" -- "0..*" EAngebot : fordert an

EKunde "1" -- "0..*" EBuchung : tätigt

EAngebot "1" -- "0..1" EBuchung : führt zu

EAngebot "0..*" -- "1" EFahrzeugtyp : betrifft

EAngebot "0..*" -- "1" EStandort : Abholort

EAngebot "0..*" -- "1" EStandort : Rückgabeort

' Weitere Beziehungen aus Aufgabe 4

EFahrzeugtyp "1" -- "1..*" EFahrzeugmodell : umfasst

EBuchung "1" -- "1" EZahlungsinformation : nutzt

EBuchung "0..*" -- "0..*" EVersicherung : wählt

EBuchung "0..*" -- "0..1" EAktionscode : verwendet

EBuchung "1" -- "0..*" EBuchungExtra : enthält

EBuchungExtra "0..*" -- "1" EExtra : bezeichnet

' Hinweise zur Zahlungsinformation

note bottom of EZahlungsinformation
  Kreditkartendaten werden geprüft.
  Für dauerhafte Speicherung werden
  nur maskierte Daten / ein Token
  modelliert, kein Kartenprüfcode.
end note
@enduml
